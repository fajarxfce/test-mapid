{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug | dev | Android via WireGuard",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/fluent_starter",
      "program": "${workspaceFolder}/apps/fluent_starter/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "dev",
        "--dart-define=FLAVOR=dev",
        "--dart-define-from-file=${workspaceFolder}/.env"
      ],
      "deviceId": "10.77.77.3:5555"
    },
    {
      "name": "Debug | staging | Android via WireGuard",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/fluent_starter",
      "program": "${workspaceFolder}/apps/fluent_starter/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "staging",
        "--dart-define=FLAVOR=staging",
        "--dart-define-from-file=${workspaceFolder}/.env"
      ],
      "deviceId": "10.77.77.3:5555"
    },
    {
      "name": "Debug | prod | Android via WireGuard",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/fluent_starter",
      "program": "${workspaceFolder}/apps/fluent_starter/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "prod",
        "--dart-define=FLAVOR=prod",
        "--dart-define-from-file=${workspaceFolder}/.env"
      ],
      "deviceId": "10.77.77.3:5555"
    },
    {
      "name": "Debug | dev | Android via SSH tunnel",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/fluent_starter",
      "program": "${workspaceFolder}/apps/fluent_starter/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "dev",
        "--dart-define=FLAVOR=dev",
        "--dart-define-from-file=${workspaceFolder}/.env"
      ],
      "deviceId": "127.0.0.1:15555"
    },
    {
      "name": "Debug | staging | Android via SSH tunnel",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/fluent_starter",
      "program": "${workspaceFolder}/apps/fluent_starter/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "staging",
        "--dart-define=FLAVOR=staging",
        "--dart-define-from-file=${workspaceFolder}/.env"
      ],
      "deviceId": "127.0.0.1:15555"
    },
    {
      "name": "Debug | prod | Android via SSH tunnel",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/fluent_starter",
      "program": "${workspaceFolder}/apps/fluent_starter/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "prod",
        "--dart-define=FLAVOR=prod",
        "--dart-define-from-file=${workspaceFolder}/.env"
      ],
      "deviceId": "127.0.0.1:15555"
    },
    {
      "name": "Debug | dev | Android",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/fluent_starter",
      "program": "${workspaceFolder}/apps/fluent_starter/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "dev",
        "--dart-define=FLAVOR=dev",
        "--dart-define-from-file=${workspaceFolder}/.env"
      ],
      "deviceId": "${input:androidDeviceId}"
    },
    {
      "name": "Debug | staging | Android",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/fluent_starter",
      "program": "${workspaceFolder}/apps/fluent_starter/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "staging",
        "--dart-define=FLAVOR=staging",
        "--dart-define-from-file=${workspaceFolder}/.env"
      ],
      "deviceId": "${input:androidDeviceId}"
    },
    {
      "name": "Debug | prod | Android",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/fluent_starter",
      "program": "${workspaceFolder}/apps/fluent_starter/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "prod",
        "--dart-define=FLAVOR=prod",
        "--dart-define-from-file=${workspaceFolder}/.env"
      ],
      "deviceId": "${input:androidDeviceId}"
    },
    {
      "name": "Debug | dev | web",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/fluent_starter",
      "program": "${workspaceFolder}/apps/fluent_starter/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define=FLAVOR=dev",
        "--dart-define-from-file=${workspaceFolder}/.env"
      ],
      "deviceId": "chrome"
    },
    {
      "name": "Debug | staging | web",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/fluent_starter",
      "program": "${workspaceFolder}/apps/fluent_starter/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define=FLAVOR=staging",
        "--dart-define-from-file=${workspaceFolder}/.env"
      ],
      "deviceId": "chrome"
    },
    {
      "name": "Debug | prod | web",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/fluent_starter",
      "program": "${workspaceFolder}/apps/fluent_starter/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define=FLAVOR=prod",
        "--dart-define-from-file=${workspaceFolder}/.env"
      ],
      "deviceId": "chrome"
    },
    {
      "name": "Attach | running Flutter VM",
      "type": "dart",
      "request": "attach",
      "cwd": "${workspaceFolder}/apps/fluent_starter",
      "program": "${workspaceFolder}/apps/fluent_starter/lib/main.dart",
      "vmServiceUri": "${input:vmServiceUri}",
      "toolArgs": [
        "--dart-define-from-file=${workspaceFolder}/.env"
      ]
    },
    {
      "name": "Debug tests | app",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/fluent_starter",
      "program": "${workspaceFolder}/apps/fluent_starter/test"
    },
    {
      "name": "Debug tests | workspace tooling",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/test"
    }
  ],
  "inputs": [
    {
      "id": "vmServiceUri",
      "type": "promptString",
      "description": "Full Dart VM service URI printed by the running Flutter app"
    },
    {
      "id": "androidDeviceId",
      "type": "promptString",
      "description": "Android device ID from flutter devices. emulator- selects a single running Android emulator; enter the exact ID for a phone or multiple emulators.",
      "default": "emulator-"
    }
  ]
}
